# All environment variables used across the project.
# ETL reads etl/.env ; the dashboard reads dashboard/.env.local (or Vercel env).
# API (android bookings) reads root .env or env

# --- SQL Server source (ETL + API write) ---
MSSQL_HOST=192.168.29.157
MSSQL_PORT=1433
MSSQL_DB=AKTIV_ANUBHAB
MSSQL_USER=sa
MSSQL_PASSWORD=replace-with-sql-server-password
# AKTIV's SQL Server speaks older TDS; the default 7.4 is rejected.
MSSQL_TDS_VERSION=7.0

# --- Neon Postgres (ETL writes, API reads master data) ---
NEON_DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# --- AKTIV API write behaviour ---
# SYS_MAST_USERS.user_key that app/online bills are stamped with (sys_insert_user_key).
# 103 is the dedicated ONLINE account. Do not point this at a real staff login
# (10 was SUBHASHIS) or every app booking shows up as that receptionist's work.
AKTIV_SYS_USER_KEY=103
AKTIV_SYS_MACHINE_KEY=27
# Keep true for real Android bookings. Set false only for explicit dry-run testing.
AKTIV_ALLOW_LIVE_BOOKINGS=true
# Used only when dry-run/test mode is explicitly enabled.
AKTIV_TEST_BILL_DATE=2025-07-02

# --- API access ---
# Shared key the app sends as X-API-Key (X-ALC-Key also accepted). It ships inside the
# APK, so it only keeps drive-by scanners out; build the app with the same value
# (GitHub secret AKTIV_API_KEY, or -PAKTIV_API_KEY=...).
AKTIV_API_KEY=replace-with-random-key
# Signs patient/staff tokens (api/tokens.py). Server-only: never put it in the APK.
AKTIV_TOKEN_SECRET=replace-with-openssl-rand-hex-32
# Where the API itself fetches report PDFs. Same box as IIS, so localhost; going via the
# public hostname gets Python's user agent a Cloudflare 403.
REPORT_FETCH_BASE=http://localhost/AKTIV

# --- Dashboard auth (Vercel / dashboard only) ---
DASHBOARD_PASSWORD=replace-with-dashboard-password
AUTH_SECRET=replace-with-openssl-rand-hex-32
