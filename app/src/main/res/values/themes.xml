<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AktivAdmin" parent="Theme.Material3.DayNight">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/medical_blue</item>
        <item name="colorPrimaryVariant">@color/clinic_primary</item>
        <item name="colorOnPrimary">@color/text_white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/medical_green</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/text_white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_dark_blue</item>
        <!-- Background colors -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <!-- Accent color -->
        <item name="colorAccent">@color/secondary</item>
        <!-- Typography -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.AktivAdmin.Headline1</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.AktivAdmin.Headline6</item>
        <item name="textAppearanceBody1">@style/TextAppearance.AktivAdmin.Body1</item>
        <!-- Button style -->
        <item name="materialButtonStyle">@style/Widget.AktivAdmin.Button</item>
        <item name="textInputStyle">@style/Widget.Anubhav.TextInput</item>
        <!-- Card style -->
        <item name="materialCardViewStyle">@style/Widget.AktivAdmin.CardView</item>
    </style>

    <!-- Customer-facing app theme (alias) -->
    <style name="Theme.AnubhavLifeCare" parent="Theme.AktivAdmin" />
    <style name="Theme.AnubhavLifeCare.NoActionBar" parent="Theme.AktivAdmin.NoActionBar" />
    <style name="Theme.AnubhavLifeCare.AppBarOverlay" parent="Theme.AktivAdmin.AppBarOverlay" />
    <style name="Theme.AnubhavLifeCare.PopupOverlay" parent="Theme.AktivAdmin.PopupOverlay" />

    <style name="Theme.AktivAdmin.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.AktivAdmin.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.AktivAdmin.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Custom Text Appearances -->
    <style name="TextAppearance.AktivAdmin.Headline1" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_dark_blue</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.AktivAdmin.Headline6" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_dark_blue</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.AktivAdmin.Body1" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Anubhav.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_dark_blue</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Anubhav.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="boxStrokeColor">@color/stroke_soft</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <style name="Widget.Anubhav.Dropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="boxStrokeColor">@color/stroke_soft</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <style name="Widget.Anubhav.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeColor">@color/stroke_soft</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Custom Button Style -->
    <style name="Widget.AktivAdmin.Button" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/gradient_button</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="elevation">4dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Custom CardView Style -->
    <style name="Widget.AktivAdmin.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <!-- Floating Action Button Style -->
    <style name="Widget.AktivAdmin.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/medical_green</item>
        <item name="tint">@color/text_white</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Navigation Drawer Style -->
    <style name="Widget.AktivAdmin.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="android:background">@color/background_light</item>
        <item name="itemTextColor">@color/nav_item_text</item>
        <item name="itemIconTint">@color/nav_item_tint</item>
        <item name="itemBackground">@drawable/nav_item_background</item>
        <item name="itemTextAppearance">@style/TextAppearance.AktivAdmin.NavigationItem</item>
        <item name="itemIconSize">28dp</item>
        <item name="itemHorizontalPadding">20dp</item>
        <item name="itemVerticalPadding">16dp</item>
        <item name="itemMaxLines">1</item>
    </style>

    <!-- Custom text appearance for navigation items -->
    <style name="TextAppearance.AktivAdmin.NavigationItem" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
